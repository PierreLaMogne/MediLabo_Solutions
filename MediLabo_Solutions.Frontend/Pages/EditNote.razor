@page "/patients/{patientId:int}/notes/new"
@page "/patients/{patientId:int}/notes/edit/{noteId}"
@attribute [Authorize]
@inject INoteApiService NoteApiService
@inject IPatientApiService PatientApiService
@inject NavigationManager NavigationManager

<PageTitle>@(IsEditMode ? "Modifier la note" : "Nouvelle note") - MédiLabo Solutions</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="mt-2"><em>Chargement...</em></p>
                </div>
            }
            else
            {
                <!-- En-tête -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">
                            <i class="bi bi-journal-medical"></i>
                            @(IsEditMode ? "Modifier la note" : "Nouvelle note médicale")
                        </h3>
                        @if (patient != null)
                        {
                            <p class="text-muted mb-0">
                                Patient : <strong>@patient.Prénom @patient.Nom</strong>
                            </p>
                        }
                    </div>
                    <button class="btn btn-secondary" @onclick="GoBack">
                        <i class="bi bi-arrow-left"></i> Retour
                    </button>
                </div>

                <!-- Formulaire -->
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-pencil-square"></i>
                            @(IsEditMode ? "Modification de la note" : "Saisie de la note")
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
                            </div>
                        }

                        <EditForm Model="@noteDto" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="date" class="form-label">
                                    <i class="bi bi-calendar-event"></i> Date de la note
                                </label>
                                <InputDate id="date" class="form-control" @bind-Value="noteDto.Date" />
                                <ValidationMessage For="@(() => noteDto.Date)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="contenu" class="form-label">
                                    <i class="bi bi-file-text"></i> Contenu de la note
                                    <span class="text-danger">*</span>
                                </label>
                                <InputTextArea id="contenu"
                                               class="form-control"
                                               @bind-Value="noteDto.Contenu"
                                               rows="10"
                                               placeholder="Saisissez les observations médicales..." />
                                <ValidationMessage For="@(() => noteDto.Contenu)" class="text-danger" />
                                <div class="form-text">
                                    <i class="bi bi-info-circle"></i>
                                    Décrivez les symptômes, observations, diagnostics ou traitements du patient.
                                </div>
                            </div>

                            <div class="d-flex justify-content-between pt-3 border-top">
                                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                                    <i class="bi bi-x-circle"></i> Annuler
                                </button>
                                <button type="submit" class="btn btn-success" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Enregistrement...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle"></i>
                                        <span>@(IsEditMode ? "Mettre à jour" : "Enregistrer")</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PatientId { get; set; }

    [Parameter]
    public string? NoteId { get; set; }

    private NoteDto noteDto = new();
    private PatientDto? patient;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    private bool IsEditMode => !string.IsNullOrEmpty(NoteId);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Charger les informations du patient
            patient = await PatientApiService.GetPatientByIdAsync(PatientId);

            if (patient == null)
            {
                errorMessage = "Patient non trouvé.";
                return;
            }

            // Si mode édition, charger la note existante
            if (IsEditMode)
            {
                var existingNote = await NoteApiService.GetNoteByIdAsync(NoteId!);
                if (existingNote != null)
                {
                    noteDto = existingNote;
                }
                else
                {
                    errorMessage = "Note non trouvée.";
                }
            }
            else
            {
                // Initialiser une nouvelle note
                noteDto = new NoteDto
                {
                    PatientId = PatientId,
                    Date = DateOnly.FromDateTime(DateTime.Today)
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            noteDto.PatientId = PatientId;

            if (IsEditMode)
            {
                var success = await NoteApiService.UpdateNoteAsync(NoteId!, noteDto);
                if (success)
                {
                    GoBack();
                }
                else
                {
                    errorMessage = "Erreur lors de la mise à jour de la note.";
                }
            }
            else
            {
                await NoteApiService.CreateNoteAsync(noteDto);
                GoBack();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'enregistrement : {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo($"/patients/{PatientId}");
    }
}