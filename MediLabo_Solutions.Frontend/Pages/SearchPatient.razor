@page "/patients/search"
@attribute [Authorize]
@inject IPatientApiService PatientApiService
@inject NavigationManager NavigationManager

<PageTitle>Rechercher un Patient - MédiLabo Solutions</PageTitle>

<div class="container mt-4">
    <h3><i class="bi bi-search"></i> Rechercher un Patient</h3>

    <!-- Formulaire de recherche -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="searchType" class="form-label">Type de recherche</label>
                    <select id="searchType" class="form-select" @bind="searchType">
                        <option value="name">Par Nom</option>
                        <option value="id">Par Identifiant</option>
                    </select>
                </div>

                @if (searchType == "name")
                {
                    <div class="col-md-6">
                        <label for="searchName" class="form-label">Nom</label>
                        <input type="text" 
                               id="searchName" 
                               class="form-control" 
                               @bind="searchName" 
                               @bind:event="oninput"
                               @onkeypress="HandleKeyPress"
                               placeholder="Entrez le nom..." />
                    </div>
                }
                else
                {
                    <div class="col-md-6">
                        <label for="searchId" class="form-label">Identifiant Patient</label>
                        <input type="number" 
                               id="searchId" 
                               class="form-control" 
                               @bind="searchId" 
                               @bind:event="oninput"
                               @onkeypress="HandleKeyPress"
                               placeholder="Entrez l'identifiant..." 
                               min="1" />
                    </div>
                }

                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="SearchPatients" disabled="@isSearching">
                        @if (isSearching)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                        }
                        Rechercher
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(searchName) || searchId > 0)
            {
                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSearch">
                        <i class="bi bi-x-circle"></i> Effacer la recherche
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Messages d'erreur -->
    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Résultats de recherche -->
    @if (hasSearched)
    {
        @if (isSearching)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Recherche en cours...</span>
                </div>
                <p class="mt-2"><em>Recherche en cours...</em></p>
            </div>
        }
        else if (searchResults == null || searchResults.TotalCount == 0)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle-fill"></i> Aucun patient trouvé pour cette recherche.
                <div class="mt-2">
                    <button class="btn btn-sm btn-primary" @onclick="CreatePatient">
                        <i class="bi bi-plus-circle"></i> Créer un nouveau patient
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul"></i> 
                            Résultats de recherche (@searchResults.TotalCount patient@(searchResults.TotalCount > 1 ? "s" : "") trouvé@(searchResults.TotalCount > 1 ? "s" : ""))
                        </h5>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-light @(pageSize == 5 ? "active" : "")" @onclick="() => ChangePageSize(5)">5</button>
                            <button class="btn btn-light @(pageSize == 10 ? "active" : "")" @onclick="() => ChangePageSize(10)">10</button>
                            <button class="btn btn-light @(pageSize == 25 ? "active" : "")" @onclick="() => ChangePageSize(25)">25</button>
                            <button class="btn btn-light @(pageSize == 50 ? "active" : "")" @onclick="() => ChangePageSize(50)">50</button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Prénom</th>
                                    <th>Nom</th>
                                    <th>Date de Naissance</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var patient in searchResults.Items)
                                {
                                    <tr>
                                        <td class="fw-bold">@patient.Id</td>
                                        <td>@patient.Prénom</td>
                                        <td>@patient.Nom</td>
                                        <td>@patient.DateDeNaissance.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary" 
                                                    @onclick="() => ViewPatient(patient.Id)"
                                                    title="Consulter">
                                                <i class="bi bi-eye"></i> Consulter
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Pagination -->
                @if (searchResults.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav aria-label="Navigation des pages">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(!searchResults.HasPreviousPage ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(1)" disabled="@(!searchResults.HasPreviousPage)">
                                        <i class="bi bi-chevron-double-left"></i>
                                    </button>
                                </li>
                                <li class="page-item @(!searchResults.HasPreviousPage ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(!searchResults.HasPreviousPage)">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                </li>
                                
                                @for (int i = GetStartPage(); i <= GetEndPage(); i++)
                                {
                                    var page = i;
                                    <li class="page-item @(page == currentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(page)">@(searchResults.PageNumber)</button>
                                    </li>
                                }
                                
                                <li class="page-item @(!searchResults.HasNextPage ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(!searchResults.HasNextPage)">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </li>
                                <li class="page-item @(!searchResults.HasNextPage ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(searchResults.TotalPages)" disabled="@(!searchResults.HasNextPage)">
                                        <i class="bi bi-chevron-double-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center mt-2 small text-muted">
                            Page @currentPage sur @searchResults.TotalPages
                            (@((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, searchResults.TotalCount) sur @searchResults.TotalCount)
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-search" style="font-size: 4rem;"></i>
            <p class="mt-3">Utilisez le formulaire ci-dessus pour rechercher un patient</p>
        </div>
    }
</div>

@code {
    private string searchType = "name";
    private string searchName = string.Empty;
    private int searchId = 0;
    private PagedResult<PatientDto>? searchResults;
    private bool isSearching = false;
    private bool hasSearched = false;
    private string? errorMessage;
    private int currentPage = 1;
    private int pageSize = 10;
    private const int MaxPagesToShow = 5;

    // Méthodes pour rechercher des patients
    private async Task SearchPatients()
    {
        if (!ValidateSearch())
        {
            return;
        }

        currentPage = 1; // Réinitialiser à la première page lors d'une nouvelle recherche
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        isSearching = true;
        hasSearched = true;
        errorMessage = null;
        searchResults = null;

        try
        {
            if (searchType == "name")
            {
                if (!string.IsNullOrWhiteSpace(searchName))
                {
                    searchResults = await PatientApiService.GetPatientByNameAsync(searchName.Trim(), currentPage, pageSize);
                }
            }
            else // searchType == "id"
            {
                if (searchId > 0)
                {
                    var patient = await PatientApiService.GetPatientByIdAsync(searchId);
                    searchResults = new PagedResult<PatientDto>
                    {
                        Items = patient != null ? new List<PatientDto> { patient } : new List<PatientDto>(),
                        TotalCount = patient != null ? 1 : 0,
                        PageNumber = 1,
                        PageSize = pageSize
                    };
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de la recherche : {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private bool ValidateSearch()
    {
        if (searchType == "name" && string.IsNullOrWhiteSpace(searchName))
        {
            errorMessage = "Veuillez entrer un nom ou un prénom.";
            return false;
        }

        if (searchType == "id" && searchId <= 0)
        {
            errorMessage = "Veuillez entrer un identifiant valide (supérieur à 0).";
            return false;
        }

        return true;
    }

    private void ClearSearch()
    {
        searchName = string.Empty;
        searchId = 0;
        searchResults = null;
        hasSearched = false;
        errorMessage = null;
        currentPage = 1;
        pageSize = 10;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchPatients();
        }
    }

    // Méthodes de pagination
    private async Task GoToPage(int page)
    {
        if (page < 1 || (searchResults != null && page > searchResults.TotalPages))
            return;

        currentPage = page;
        await PerformSearch();
    }

    private async Task ChangePageSize(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1; // Retour à la première page
        await PerformSearch();
    }

    private int GetStartPage()
    {
        if (searchResults == null) return 1;
        
        var half = MaxPagesToShow / 2;
        var start = currentPage - half;
        
        if (start < 1) start = 1;
        if (start + MaxPagesToShow > searchResults.TotalPages)
            start = Math.Max(1, searchResults.TotalPages - MaxPagesToShow + 1);
        
        return start;
    }

    private int GetEndPage()
    {
        if (searchResults == null) return 1;
        
        var end = GetStartPage() + MaxPagesToShow - 1;
        return Math.Min(end, searchResults.TotalPages);
    }
    
    // Méthodes de formatage et de calcul pour l'affichage
    private string GetGenreLabel(string genre)
    {
        return genre switch
        {
            "M" => "Masculin",
            "F" => "Féminin",
            "NB" => "Non-binaire",
            _ => genre
        };
    }

    private int CalculateAge(DateOnly birthDate)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - birthDate.Year;

        if (birthDate > today.AddYears(-age))
        {
            age--;
        }

        return age;
    }

    // Méthodes pour créer, consulter et modifier un patient
    private void ViewPatient(int id)
    {
        NavigationManager.NavigateTo($"/patients/{id}");
    }

    private void EditPatient(int id)
    {
        NavigationManager.NavigateTo($"/patients/edit/{id}");
    }

    private void CreatePatient()
    {
        NavigationManager.NavigateTo("/patients/create");
    }
}