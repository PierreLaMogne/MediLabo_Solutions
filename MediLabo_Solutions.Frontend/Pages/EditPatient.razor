@page "/patients/edit/{id:int}"
@page "/patients/create"
@attribute [Authorize]
@inject IPatientApiService PatientApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@(IsCreateMode ? "Créer un Patient" : "Modifier le Patient") - MédiLabo Solutions</PageTitle>

<div class="container mt-4">
    <h3>@(IsCreateMode ? "Créer un Patient" : "Modifier le Patient")</h3>

    @if (isLoading)
    {
        <p><em>Chargement des informations du patient...</em></p>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
        <button class="btn btn-secondary" @onclick="Cancel">Annuler</button>
    }
    else if (!IsCreateMode && patient == null)
    {
        <div class="alert alert-warning" role="alert">
            Patient non trouvé.
        </div>
        <button class="btn btn-secondary" @onclick="GoBackToList">Retour à la liste</button>
    }
    else
    {
        <EditForm Model="@patient" OnValidSubmit="@HandleValidSubmit" FormName="editPatientForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="prenom" class="form-label">Prénom <span class="text-danger">*</span></label>
                            <InputText id="prenom" class="form-control" @bind-Value="patient!.Prénom" />
                            <ValidationMessage For="@(() => patient!.Prénom)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="nom" class="form-label">Nom <span class="text-danger">*</span></label>
                            <InputText id="nom" class="form-control" @bind-Value="patient!.Nom" />
                            <ValidationMessage For="@(() => patient!.Nom)" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="dateNaissance" class="form-label">Date de Naissance <span class="text-danger">*</span></label>
                            <InputDate id="dateNaissance" class="form-control" @bind-Value="dateDeNaissance" />
                            <ValidationMessage For="@(() => patient!.DateDeNaissance)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="genre" class="form-label">Genre <span class="text-danger">*</span></label>
                            <InputSelect id="genre" class="form-select" @bind-Value="patient!.Genre">
                                <option value="">-- Sélectionnez --</option>
                                <option value="M">Masculin</option>
                                <option value="F">Féminin</option>
                                <option value="NB">Non-binaire</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => patient!.Genre)" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="adresse" class="form-label">Adresse Postale</label>
                            <InputText id="adresse" class="form-control" @bind-Value="patient!.AdressePostale" />
                            <ValidationMessage For="@(() => patient!.AdressePostale)" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="telephone" class="form-label">Numéro de Téléphone</label>
                            <InputText id="telephone" class="form-control" @bind-Value="patient!.NuméroDeTéléphone" placeholder="Ex: 01 23 45 67 89" />
                            <ValidationMessage For="@(() => patient!.NuméroDeTéléphone)" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    <i class="bi bi-save"></i> @(IsCreateMode ? "Créer" : "Enregistrer")
                </button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel" disabled="@isSaving">
                    <i class="bi bi-x-circle"></i> Annuler
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromForm]
    private PatientDto? patient { get; set; }

    private DateTime dateDeNaissance;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    private bool IsCreateMode => Id == null || Id == 0;

    protected override async Task OnInitializedAsync()
    {
        if (IsCreateMode)
        {
            // Mode création : initialiser un nouveau patient
            patient = new PatientDto
            {
                DateDeNaissance = DateOnly.FromDateTime(DateTime.Today.AddYears(-30))
            };
            dateDeNaissance = DateTime.Today.AddYears(-30);
            isLoading = false;
        }
        else
        {
            // Mode édition : charger le patient existant
            await LoadPatient();
        }
    }

    private async Task LoadPatient()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            patient = await PatientApiService.GetPatientByIdAsync(Id!.Value);
            if (patient != null)
            {
                // Convertir DateOnly en DateTime pour InputDate
                dateDeNaissance = patient.DateDeNaissance.ToDateTime(TimeOnly.MinValue);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement du patient : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (patient == null) return;

        isSaving = true;
        errorMessage = null;

        try
        {
            // Convertir DateTime en DateOnly
            patient.DateDeNaissance = DateOnly.FromDateTime(dateDeNaissance);

            if (IsCreateMode)
            {
                // Création d'un nouveau patient
                var createdPatient = await PatientApiService.CreatePatientAsync(patient);
                await JSRuntime.InvokeVoidAsync("alert", "Patient créé avec succès !");
                NavigationManager.NavigateTo($"/patients/{createdPatient.Id}");
            }
            else
            {
                // Modification d'un patient existant
                var updatedPatient = await PatientApiService.UpdatePatientAsync(Id!.Value, patient);

                if (updatedPatient != null)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Patient modifié avec succès !");
                    NavigationManager.NavigateTo($"/patients/{Id}");
                }
                else
                {
                    errorMessage = "Patient non trouvé.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de {(IsCreateMode ? "la création" : "la modification")} du patient : {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        if (IsCreateMode)
        {
            NavigationManager.NavigateTo("/patients");
        }
        else
        {
            NavigationManager.NavigateTo($"/patients/{Id}");
        }
    }

    private void GoBackToList()
    {
        NavigationManager.NavigateTo("/patients");
    }
}