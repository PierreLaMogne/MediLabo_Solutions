@page "/"
@inject NavigationManager NavigationManager

<PageTitle>Accueil - MédiLabo Solutions</PageTitle>

<h1>Bienvenue sur MédiLabo Solutions</h1>

<h3>Que souhaitez-vous faire ?</h3>

<button class="btn btn-primary" @onclick="NavigateToPatients">Consulter la liste des patients</button>
<button class="btn btn-primary" @onclick="NavigateToSearch">Rechercher un patient</button>
<button class="btn btn-primary" @onclick="NavigateToCreate">Ajouter un patient</button>

@code {
    private void NavigateToPatients()
    {
        NavigationManager.NavigateTo("/patients");
    }

    private void NavigateToSearch()
    {
        NavigationManager.NavigateTo("/patients/search");
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo("/patients/create");
    }
}