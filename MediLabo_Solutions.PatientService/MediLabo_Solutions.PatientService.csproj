    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fcf114ed-49e4-4f48-91e4-5324d1d7d8c8</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
